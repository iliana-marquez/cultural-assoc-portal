# =============================================================
# Organisation Website System — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control
# =============================================================

# ── Application ──────────────────────────────────────────────
APP_DEBUG="false"               # true for development, false for production
ADMIN_PATH=""                   # Secret admin URL — REQUIRED, set unique per deployment

# ── Database ─────────────────────────────────────────────────
DB_HOST="localhost"
DB_NAME=""
DB_USER=""     
DB_PASS=""                      
# avoid special characters: ! # $ % & ' "                  

# ── Mail ─────────────────────────────────────────────────────
MAIL_HOST=""                    # smtp.gmail.com / mail.easyname.com
MAIL_PORT="587"                 # 587 (TLS), 465 (SSL) — check your provider's docs
MAIL_USERNAME=""                # your SMTP email address
MAIL_PASSWORD=""                # Gmail: use App Password, not account password
MAIL_FROM=""                    # sender email address
MAIL_FROM_NAME=""               # sender display name

